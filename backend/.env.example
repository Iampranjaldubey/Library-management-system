# Backend environment variables. Copy to a real secret store / host dashboard.
# NEVER commit real secrets — this file only documents the required keys.

# ── Database ──────────────────────────────────────────────────────────────────
# Free managed MySQL: Aiven (https://aiven.io/free-mysql-database). Paste the
# JDBC URI it gives you, including the SSL parameter.
DB_URL=jdbc:mysql://<host>:<port>/<database>?ssl-mode=REQUIRED
DB_USERNAME=avnadmin
DB_PASSWORD=your-db-password

# ── JWT ─────────────────────────────────────────────────────────────────────────
# Base64-encoded, must decode to >= 32 bytes (HS256). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-base64-encoded-secret

# ── Refresh-token cookie ────────────────────────────────────────────────────────
# Defaults suit HTTPS + the Vercel same-origin proxy. For plain cross-origin
# calls the browser also requires SameSite=None + Secure=true.
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=None

# ── Application ─────────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend.vercel.app
# Demo-friendly: allow login without SMTP verification.
# Set to true AND configure MAIL_* below to require verified email in production.
APP_AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ── SMTP (optional; only needed when email verification / reset emails are on) ──
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@example.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM=noreply@libraryos.com

# ── Server ──────────────────────────────────────────────────────────────────────
# PORT is injected by the platform (Render/Fly set it). Local default is 8080.
# PORT=8080
