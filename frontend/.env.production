# Production frontend config.
#
# The browser talks to THIS app same-origin at /api/*, and next.config.mjs
# proxies those calls to the backend. Set the upstream backend URL as a
# SERVER-side env var on your host (do NOT hardcode a per-deploy URL here):
#
#   Vercel  ->  BACKEND_API_URL=https://<your-app>.onrender.com
#
# (Leaving it unset makes the proxy fall back to http://localhost:8080.)

NEXT_PUBLIC_APP_NAME="Library Management System"
NEXT_PUBLIC_APP_VERSION="1.0.0"
