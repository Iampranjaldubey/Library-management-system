# Production frontend config template. Copy to .env.production (or set in your host).
#
# The browser calls this app same-origin (/api/*); next.config.mjs proxies to the
# backend. Set the upstream as a SERVER-side env var (not NEXT_PUBLIC_*):
#
#   BACKEND_API_URL=https://<your-app>.onrender.com
#
# Don't hardcode a per-deploy backend URL in a committed file.

NEXT_PUBLIC_APP_NAME="Library Management System"
NEXT_PUBLIC_APP_VERSION="1.0.0"
